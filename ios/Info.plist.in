<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
	<key>CFBundleIdentifier</key>
	<string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
	<key>CFBundleDisplayName</key>
	<string>Retro-3DO</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
	<key>CFBundleVersion</key>
	<string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>15.0</string>

	<!-- Declared here so no upload stops to ask. Without this key App Store
	     Connect raises the export-compliance question on every delivery and
	     holds the build out of TestFlight until someone answers it by hand.
	     False is the accurate answer: the emulator uses no encryption of its
	     own, and HTTPS through the system libraries is exempt. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Purpose strings are required for APIs the binary LINKS, not only ones
	     it calls, and SDL links several: nm -u on the built binary shows
	     AVAudioSession, AVCaptureSession, AVCaptureDevice, CBCentralManager
	     and CMMotionManager. Without these the upload is accepted and then
	     discarded in processing as ITMS-90683, hours later, by email. The CI
	     job derives the list from the binary rather than trusting this
	     comment. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Retro-3DO uses Bluetooth only to connect game controllers. It collects no data and never scans for anything else.</string>
	<key>NSCameraUsageDescription</key>
	<string>Retro-3DO does not use the camera. This entry is required because the SDL library the app is built on links Apple's camera APIs, and iOS asks for the description whether or not they are ever called.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Retro-3DO does not record audio. This entry is required because the SDL library the app is built on links Apple's audio-recording APIs, and iOS asks for the description whether or not they are ever called.</string>
	<key>NSMotionUsageDescription</key>
	<string>Retro-3DO does not read motion sensors. This entry is required because the SDL library the app is built on links Apple's motion APIs, and iOS asks for the description whether or not they are ever called.</string>

	<!-- A launch screen has to be declared, but naming a storyboard would pull
	     in ibtool, which only exists on macOS. An empty dictionary satisfies
	     iOS without adding that dependency. -->
	<key>UILaunchScreen</key>
	<dict/>

	<!-- Without these two the Documents folder never appears in the Files app,
	     and there is no way for anyone to get a BIOS or a disc image onto the
	     device. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIRequiresFullScreen</key>
	<true/>
</dict>
</plist>
